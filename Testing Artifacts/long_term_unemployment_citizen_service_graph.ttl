@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/> .
@prefix ns1: <http://example.org/schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:long_term_unemployment a cpsv:PublicService ;
    cpsv:holdsRequirement ex:age_at_application_condition,
        ex:annual_family_income_threshold_condition,
        ex:application_submission_deadline_condition,
        ex:citizenship_condition,
        ex:continuous_unemployment_registration_condition,
        ex:regular_unemployment_benefit_exhaustion_condition,
        ex:unemployment_insurance_condition .

ex:age_at_application_condition a cccev:Constraint ;
    cccev:constrains ex:applicant_birth_date ;
    dct:description "Be aged from 20 to 66 years at the time of application." .

ex:annual_family_income a cccev:InformationConcept ;
    ex:mapsTo ex:FrankyIncome,
        ex:ManolisIncome .

ex:annual_family_income_threshold_condition a cccev:Constraint ;
    cccev:constrains ex:annual_family_income,
        ex:dependent_child_birth_dates,
        ex:family_income_tax_year,
        ex:spouse ;
    dct:description "Have annual family income not exceeding €10,000, increased by €586.08 for each dependent child under 18. Annual family income includes the applicant's, spouse's, and minor children's total annual taxable, exempt, or specially taxed income from all sources for the tax year two years before entitlement is exercised, excluding severance compensation. Unemployment, sickness, maternity, and long-term unemployment benefits are not included in annual family income. For unmarried adult beneficiaries, family income means the individual's income." .

ex:applicant_birth_date a cccev:InformationConcept ;
    ex:mapsTo ex:Franky .

ex:application_submission_deadline_condition a cccev:Constraint ;
    cccev:constrains ex:regular_benefit_months_paid,
        ex:regular_benefit_start_date ;
    dct:description "Submit the application, with the required supporting documents, within two months of the end of the 12-month regular unemployment benefit." .

ex:citizenship_condition a cccev:Constraint ;
    cccev:constrains ex:citizenship_country ;
    dct:description "Be a Greek citizen or a citizen of an EU Member State." .

ex:citizenship_country a cccev:InformationConcept ;
    ex:mapsTo ex:Franky .

ex:continuous_unemployment_registration_condition a cccev:Constraint ;
    cccev:constrains ex:current_unemployment_registration_status,
        ex:unemployment_registration_start_date ;
    dct:description "At the date of application, have completed 12 consecutive months of unemployment and remain registered in the DYPA unemployment register." .

ex:current_unemployment_registration_status a cccev:InformationConcept ;
    ex:mapsTo ex:FrankyRegistration .

ex:dependent_child_birth_dates a cccev:InformationConcept ;
    ex:mapsTo ex:Veronica .

ex:family_income_tax_year a cccev:InformationConcept ;
    ex:mapsTo ex:FrankyIncome,
        ex:ManolisIncome .

ex:regular_unemployment_benefit_exhaustion_condition a cccev:Constraint ;
    cccev:constrains ex:regular_benefit_months_paid,
        ex:regular_benefit_start_date ;
    dct:description "Have exhausted entitlement to the 12-month regular unemployment benefit." .

ex:spouse a cccev:InformationConcept ;
    ex:mapsTo ex:Manolis .

ex:unemployment_insurance_condition a cccev:Constraint ;
    dct:description "Be insured against unemployment." .

ex:unemployment_registration_start_date a cccev:InformationConcept ;
    ex:mapsTo ex:FrankyRegistration .

ex:Franky a ns1:Applicant,
        ns1:Person ;
    ns1:birthDate "1966-02-10"^^xsd:date ;
    ns1:citizenshipCountry "GR" ;
    ns1:hasChild ex:Veronica ;
    ns1:hasIncome ex:FrankyIncome ;
    ns1:hasRegularBenefitRecord ex:FrankyRegularBenefit ;
    ns1:hasSpouse ex:Manolis ;
    ns1:hasUnemploymentRegistration ex:FrankyRegistration .

ex:Manolis a ns1:Person ;
    ns1:birthDate "1964-11-05"^^xsd:date ;
    ns1:hasIncome ex:ManolisIncome .

ex:Veronica a ns1:Person ;
    ns1:birthDate "2011-04-18"^^xsd:date .

ex:regular_benefit_months_paid a cccev:InformationConcept ;
    ex:mapsTo ex:FrankyRegularBenefit .

ex:regular_benefit_start_date a cccev:InformationConcept ;
    ex:mapsTo ex:FrankyRegularBenefit .

ex:FrankyIncome a ns1:IncomeRecord ;
    ns1:amount 6500.0 ;
    ns1:incomeYear "2024"^^xsd:gYear .

ex:FrankyRegistration a ns1:UnemploymentRegistration ;
    ns1:isCurrentlyRegistered true ;
    ns1:registrationStartDate "2025-07-07"^^xsd:date .

ex:FrankyRegularBenefit a ns1:RegularBenefitRecord ;
    ns1:regularBenefitMonthsPaid 12 ;
    ns1:regularBenefitStartDate "2024-05-07"^^xsd:date .

ex:ManolisIncome a ns1:IncomeRecord ;
    ns1:amount 4000.0 ;
    ns1:incomeYear "2024"^^xsd:gYear .

