@prefix ex: <http://example.org/> .
    @prefix cccev: <http://data.europa.eu/m8g/> .
    @prefix cpsv: <http://purl.org/vocab/cpsv#> .
    @prefix dct: <http://purl.org/dc/terms/> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

    ex:student_housing a cpsv:PublicService .

ex:student_housing cpsv:holdsRequirement ex:nationality_condition .
ex:nationality_condition a cccev:Constraint ; dct:description "The student must be a Greek national or a national of another European Union Member State." .
ex:nationality_condition cccev:constrains ex:citizenship_country .
ex:citizenship_country a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:taxisnet_credentials_condition .
ex:taxisnet_credentials_condition a cccev:Constraint ; dct:description "The applicant must hold TAXISnet login credentials." .

ex:student_housing cpsv:holdsRequirement ex:valid_academic_identity_card_condition .
ex:valid_academic_identity_card_condition a cccev:Constraint ; dct:description "The student must hold a valid academic identity card." .
ex:valid_academic_identity_card_condition cccev:constrains ex:academic_identity_card_validity .
ex:academic_identity_card_validity a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:rented_study_residence_condition .
ex:rented_study_residence_condition a cccev:Constraint ; dct:description "The student must reside, for study purposes, in rented accommodation in a city other than their principal residence. Neither the student nor their parents may hold full ownership or usufruct rights over a residence in that city." .
ex:rented_study_residence_condition cccev:constrains ex:current_residence_type .
ex:current_residence_type a cccev:InformationConcept .
ex:rented_study_residence_condition cccev:constrains ex:study_city .
ex:study_city a cccev:InformationConcept .
ex:rented_study_residence_condition cccev:constrains ex:current_residence_city .
ex:current_residence_city a cccev:InformationConcept .
ex:rented_study_residence_condition cccev:constrains ex:principal_residence_city .
ex:principal_residence_city a cccev:InformationConcept .
ex:rented_study_residence_condition cccev:constrains ex:student_or_parent_owned_property_city .
ex:student_or_parent_owned_property_city a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:minimum_lease_duration_condition .
ex:minimum_lease_duration_condition a cccev:Constraint ; dct:description "The lease must be valid for at least six months." .
ex:minimum_lease_duration_condition cccev:constrains ex:lease_start_date .
ex:lease_start_date a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:residential_property_area_limit_condition .
ex:residential_property_area_limit_condition a cccev:Constraint ; dct:description "The student’s parents, or the student themself, must not own or hold usufruct rights over owner-occupied or rented residences exceeding a total of 200 sq. m.; residences or apartments located in a municipality or community with fewer than 3,000 inhabitants are excluded from this calculation." .
ex:residential_property_area_limit_condition cccev:constrains ex:aggregated_residential_property_area .
ex:aggregated_residential_property_area a cccev:InformationConcept .
ex:residential_property_area_limit_condition cccev:constrains ex:property_municipality .
ex:property_municipality a cccev:InformationConcept .
ex:residential_property_area_limit_condition cccev:constrains ex:property_municipality_population .
ex:property_municipality_population a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:family_income_threshold_condition .
ex:family_income_threshold_condition a cccev:Constraint ; dct:description "The family’s annual income for the preceding year must not exceed €30,000, increased by €3,000 for each dependent child beyond the first." .
ex:family_income_threshold_condition cccev:constrains ex:aggregated_family_annual_income .
ex:aggregated_family_annual_income a cccev:InformationConcept .
ex:family_income_threshold_condition cccev:constrains ex:income_record_year .
ex:income_record_year a cccev:InformationConcept .
ex:family_income_threshold_condition cccev:constrains ex:dependent_children .
ex:dependent_children a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:course_completion_condition .
ex:course_completion_condition a cccev:Constraint ; dct:description "The student must have successfully passed examinations in at least half of the courses of the preceding academic year for which the allowance is requested." .
ex:course_completion_condition cccev:constrains ex:passed_courses_count .
ex:passed_courses_count a cccev:InformationConcept .
ex:course_completion_condition cccev:constrains ex:total_courses_count .
ex:total_courses_count a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:parent_beneficiary_afm_condition .
ex:parent_beneficiary_afm_condition a cccev:Constraint ; dct:description "Where the parent is the beneficiary, the application must state the taxpayer identification number (AFM) of the student and of the parent on whom the student is dependent. For divorced or separated parents, the beneficiary is the parent on whom the student is dependent." .

ex:student_housing cpsv:holdsRequirement ex:parent_tax_return_filing_condition .
ex:parent_tax_return_filing_condition a cccev:Constraint ; dct:description "The relevant parent must have filed an income tax return for the year in which the housing-allowance application is submitted." .

ex:student_housing cpsv:holdsRequirement ex:exceptional_student_beneficiary_condition .
ex:exceptional_student_beneficiary_condition a cccev:Constraint ; dct:description "The student may exceptionally be the beneficiary if they are orphaned by both parents; have parents residing abroad; are over 25 years old; or are required to file an income tax return and are not considered a dependent member under Article 11 of Law 4172/2013. In this case, the student declares only their spouse’s AFM, if applicable." .
ex:exceptional_student_beneficiary_condition cccev:constrains ex:student_birth_date .
ex:student_birth_date a cccev:InformationConcept .
ex:exceptional_student_beneficiary_condition cccev:constrains ex:student_dependency_status .
ex:student_dependency_status a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:cohabiting_student_eligibility_condition .
ex:cohabiting_student_eligibility_condition a cccev:Constraint ; dct:description "For the cohabitation-based allowance, the cohabiting person must be an undergraduate student at a higher education institution pursuing their first degree and must not have exceeded the study duration, in semesters, required by the curriculum to obtain that degree." .

ex:student_housing cpsv:holdsRequirement ex:cohabitation_same_study_location_condition .
ex:cohabitation_same_study_location_condition a cccev:Constraint ; dct:description "For the cohabitation-based allowance, the student and the cohabiting student must study in the same city or regional unit." .

ex:student_housing cpsv:holdsRequirement ex:cohabiting_student_degree_and_duration_condition .
ex:cohabiting_student_degree_and_duration_condition a cccev:Constraint ; dct:description "The cohabiting student must not hold another higher-education degree and must not have exceeded the maximum study-period limit in semesters provided by the Study Regulations." .

ex:student_housing cpsv:holdsRequirement ex:cohabitation_tenant_afm_or_dependency_condition .
ex:cohabitation_tenant_afm_or_dependency_condition a cccev:Constraint ; dct:description "For the cohabitation-based allowance, the AFM declared as tenant on behalf of the other student must match the cohabiting student’s AFM, or the cohabiting student must include the student as a dependent child in their tax return." .

ex:student_housing cpsv:holdsRequirement ex:cohabitation_lease_tenant_afm_condition .
ex:cohabitation_lease_tenant_afm_condition a cccev:Constraint ; dct:description "For the cohabitation-based allowance, the lease submitted with the application must list as tenant the AFM declared for the cohabiting student." .

