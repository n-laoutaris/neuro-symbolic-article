@prefix : <http://example.org/schema#> .
@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:nationalityConditionShape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:property [
        sh:path :citizenshipCountry ;
        sh:minCount 1 ;
        sh:in (
            "GR"
            "AT" "BE" "BG" "HR" "CY" "CZ" "DK" "EE" "FI"
            "FR" "DE" "EL" "HU" "IE" "IT" "LV" "LT" "LU"
            "MT" "NL" "PL" "PT" "RO" "SK" "SI" "ES" "SE"
        ) ;
        sh:message "The student must be a Greek national or a national of a European Union Member State." ;
    ] .

ex:validAcademicIdentityCardConditionShape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The student does not hold a valid academic identity card." ;
        sh:select """
            PREFIX : <http://example.org/schema#>
            SELECT ?this
            WHERE {
                FILTER NOT EXISTS {
                    ?this :hasEducation ?education .
                    ?education :hasValidAcademicID true .
                }
            }
        """ ;
    ] .

ex:rentedStudyResidenceConditionShape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The student must live in rented accommodation in the city of study, different from the principal residence, and neither the student nor a parent may own property in that city." ;
        sh:select """
            PREFIX : <http://example.org/schema#>
            SELECT ?this
            WHERE {
                FILTER NOT EXISTS {
                    ?this :hasCurrentResidence ?currentResidence .
                    ?currentResidence :residenceType "Rented" .
                    ?currentResidence :locatedIn ?studyCity .

                    ?this :hasEducation ?education .
                    ?education :cityOfStudy ?studyCity .

                    ?this :hasFamilyResidence ?familyResidence .
                    ?familyResidence :locatedIn ?principalResidenceCity .
                    FILTER (?principalResidenceCity != ?studyCity)

                    FILTER NOT EXISTS {
                        {
                            ?this :ownsRealEstate ?property .
                            ?property :propertyLocation ?studyCity .
                        }
                        UNION
                        {
                            ?this :hasParent ?parent .
                            ?parent :ownsRealEstate ?property .
                            ?property :propertyLocation ?studyCity .
                        }
                    }
                }
            }
        """ ;
    ] .

ex:minimumLeaseDurationConditionShape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The current residence lease has not been valid for at least six months." ;
        sh:select """
            PREFIX : <http://example.org/schema#>
            SELECT ?this
            WHERE {
                FILTER NOT EXISTS {
                    ?this :hasCurrentResidence ?residence .
                    ?residence :leaseStartDate ?startDate .
                    FILTER (
                        ((YEAR(now()) * 12 + MONTH(now())) -
                         (YEAR(?startDate) * 12 + MONTH(?startDate))) >= 6
                    )
                }
            }
        """ ;
    ] .

ex:residentialPropertyAreaLimitConditionShape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The total area of residential properties in municipalities with at least 3,000 inhabitants exceeds 200 square metres." ;
        sh:select """
            PREFIX : <http://example.org/schema#>
            SELECT ?this
            WHERE {
                {
                    SELECT ?this (SUM(?area) AS ?totalArea)
                    WHERE {
                        SELECT DISTINCT ?this ?property ?area
                        WHERE {
                            {
                                ?this :ownsRealEstate ?property .
                            }
                            UNION
                            {
                                ?this :hasParent ?parent .
                                ?parent :ownsRealEstate ?property .
                            }

                            ?property :propertyAreaM2 ?area .
                            ?property :propertyLocation ?municipality .
                            ?municipality :municipalityPopulation ?population .
                            FILTER (?population >= 3000)
                        }
                    }
                    GROUP BY ?this
                }
                FILTER (?totalArea > 200)
            }
        """ ;
    ] .

ex:familyIncomeThresholdConditionShape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The family's annual income exceeds the permitted threshold of €30,000 plus €3,000 for each dependent child beyond the first." ;
        sh:select """
            PREFIX : <http://example.org/schema#>
            SELECT ?this
            WHERE {
                {
                    SELECT ?this (SUM(?amount) AS ?totalIncome)
                    WHERE {
                        SELECT DISTINCT ?this ?incomeRecord ?amount
                        WHERE {
                            {
                                ?this :hasIncome ?incomeRecord .
                            }
                            UNION
                            {
                                ?this :hasParent ?parent .
                                ?parent :hasIncome ?incomeRecord .
                            }

                            ?incomeRecord :amount ?amount .
                        }
                    }
                    GROUP BY ?this
                }

                {
                    SELECT ?this (COUNT(DISTINCT ?child) AS ?dependentChildren)
                    WHERE {
                        ?this a :Applicant .

                        OPTIONAL {
                            ?this :hasParent ?parentForChild .
                            ?parentForChild :hasChild ?child .
                            ?child :isDependent true .
                        }
                    }
                    GROUP BY ?this
                }

                FILTER (
                    ?totalIncome >
                    (30000 + (3000 * IF(?dependentChildren > 1, ?dependentChildren - 1, 0)))
                )
            }
        """ ;
    ] .

ex:courseCompletionConditionShape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The student has not passed examinations in at least half of the courses of the preceding academic year." ;
        sh:select """
            PREFIX : <http://example.org/schema#>
            SELECT ?this
            WHERE {
                FILTER NOT EXISTS {
                    ?this :hasEducation ?education .
                    ?education :passedCoursesCount ?passedCourses .
                    ?education :totalCoursesCount ?totalCourses .
                    FILTER ((?passedCourses * 2) >= ?totalCourses)
                }
            }
        """ ;
    ] .