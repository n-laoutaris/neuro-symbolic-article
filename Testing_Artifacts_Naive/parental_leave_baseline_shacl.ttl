@prefix : <http://example.org/schema#> .
@prefix ex: <http://example.org/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ApplicantEligibilityShape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicant must have at least one child who has not reached eight years of age." ;
        sh:select """
            PREFIX : <http://example.org/schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT DISTINCT ?this
            WHERE {
                FILTER NOT EXISTS {
                    ?this :hasChild ?child .
                    ?child :birthDate ?birthDate .

                    FILTER(DATATYPE(?birthDate) = xsd:date)

                    BIND(
                        YEAR(NOW()) - YEAR(?birthDate) -
                        IF(
                            MONTH(NOW()) < MONTH(?birthDate) ||
                            (
                                MONTH(NOW()) = MONTH(?birthDate) &&
                                DAY(NOW()) < DAY(?birthDate)
                            ),
                            1,
                            0
                        )
                        AS ?childAge
                    )

                    FILTER(?childAge >= 0 && ?childAge < 8)
                }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicant must have an active employment record in the private or public sector whose current employment or continuous contract series began at least one year ago." ;
        sh:select """
            PREFIX : <http://example.org/schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            SELECT DISTINCT ?this
            WHERE {
                FILTER NOT EXISTS {
                    ?this :hasEmployment ?employment .
                    ?employment :isActive ?active .
                    ?employment :employmentSector ?sector .
                    ?employment :employmentStartDate ?startDate .

                    FILTER(
                        DATATYPE(?active) = xsd:boolean &&
                        ?active = true
                    )

                    FILTER(
                        DATATYPE(?sector) = xsd:string &&
                        (
                            ?sector = "Private" ||
                            ?sector = "Public"
                        )
                    )

                    FILTER(DATATYPE(?startDate) = xsd:date)

                    BIND(
                        YEAR(NOW()) - YEAR(?startDate) -
                        IF(
                            MONTH(NOW()) < MONTH(?startDate) ||
                            (
                                MONTH(NOW()) = MONTH(?startDate) &&
                                DAY(NOW()) < DAY(?startDate)
                            ),
                            1,
                            0
                        )
                        AS ?completedEmploymentYears
                    )

                    FILTER(?completedEmploymentYears >= 1)
                }
            }
        """
    ] .