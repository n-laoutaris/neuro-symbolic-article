@prefix : <http://example.org/schema#> .
@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:working_parent_or_parental_responsibility_shape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicant does not have both a child and an active employment record required for a working parent or person exercising parental responsibility." ;
        sh:select """
            PREFIX : <http://example.org/schema#>

            SELECT ?this
            WHERE {
                FILTER NOT EXISTS {
                    ?this :hasChild ?child .
                    ?this :hasEmployment ?employment .
                    ?employment :isActive true .
                }
            }
        """
    ] .

:child_age_shape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A child linked to the applicant is eight years old or older, or does not have a recorded birth date." ;
        sh:select """
            PREFIX : <http://example.org/schema#>

            SELECT ?this
            WHERE {
                {
                    ?this :hasChild ?child .
                    FILTER NOT EXISTS {
                        ?child :birthDate ?birthDate .
                    }
                }
                UNION
                {
                    ?this :hasChild ?child .
                    ?child :birthDate ?birthDate .
                    FILTER ((YEAR(now()) - YEAR(?birthDate)) >= 8)
                }
            }
        """
    ] .

:eligible_employment_relationship_shape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An active employment relationship is not in an eligible private or public employment sector." ;
        sh:select """
            PREFIX : <http://example.org/schema#>

            SELECT ?this
            WHERE {
                ?this :hasEmployment ?activeEmployment .
                ?activeEmployment :isActive true .

                FILTER NOT EXISTS {
                    ?this :hasEmployment ?eligibleEmployment .
                    ?eligibleEmployment :isActive true .
                    ?eligibleEmployment :employmentSector ?sector .
                    FILTER (?sector IN ("Private", "Public"))
                }
            }
        """
    ] .

:one_year_same_employer_shape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An active employment record does not have a recorded start date at least twelve months ago." ;
        sh:select """
            PREFIX : <http://example.org/schema#>

            SELECT ?this
            WHERE {
                ?this :hasEmployment ?activeEmployment .
                ?activeEmployment :isActive true .

                FILTER NOT EXISTS {
                    ?this :hasEmployment ?eligibleEmployment .
                    ?eligibleEmployment :isActive true .
                    ?eligibleEmployment :employmentStartDate ?startDate .
                    FILTER (
                        ((YEAR(now()) * 12 + MONTH(now())) -
                         (YEAR(?startDate) * 12 + MONTH(?startDate))) >= 12
                    )
                }
            }
        """
    ] .