@prefix : <http://example.org/schema#> .
@prefix ex: <http://example.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:working_parent_or_parental_responsibility_shape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicant must be a working parent or a person exercising parental responsibility for a child." ;
        sh:select """
            SELECT ?this
            WHERE {
                FILTER NOT EXISTS {
                    ?this :hasChild ?child .
                }
                FILTER NOT EXISTS {
                    ?this :hasEmployment ?employment .
                    ?employment :isActive true .
                }
            }
        """ ;
    ] .

ex:child_age_limit_shape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A child of the applicant has reached eight years of age." ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this :hasChild ?child .
                ?child :birthDate ?birthDate .
                FILTER ((YEAR(now()) - YEAR(?birthDate)) >= 8)
            }
        """ ;
    ] .

ex:eligible_employment_relationship_shape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The applicant does not have an active eligible employment relationship in the private or public sector." ;
        sh:select """
            SELECT ?this
            WHERE {
                FILTER NOT EXISTS {
                    ?this :hasEmployment ?employment .
                    ?employment :isActive true .
                    ?employment :employmentSector ?sector .
                    FILTER (?sector IN ("Private", "Public"))
                }
            }
        """ ;
    ] .

ex:one_year_same_employer_shape
    a sh:NodeShape ;
    sh:targetClass :Applicant ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An active employment relationship has not completed at least one year of employment." ;
        sh:select """
            SELECT ?this
            WHERE {
                ?this :hasEmployment ?employment .
                ?employment :isActive true .
                ?employment :employmentStartDate ?startDate .
                FILTER (
                    ((YEAR(now()) * 12 + MONTH(now())) -
                     (YEAR(?startDate) * 12 + MONTH(?startDate))) < 12
                )
            }
        """ ;
    ] .