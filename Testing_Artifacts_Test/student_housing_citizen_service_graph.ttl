@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/> .
@prefix ns1: <http://example.org/schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:student_housing a cpsv:PublicService ;
    cpsv:holdsRequirement ex:application_submission_deadline_condition,
        ex:cohabitation_tax_identification_condition,
        ex:cohabiting_student_eligibility_condition,
        ex:combined_eligible_property_area_limit_condition,
        ex:divorced_or_separated_parent_beneficiary_condition,
        ex:eu_or_greek_nationality_condition,
        ex:exceptional_student_beneficiary_condition,
        ex:family_income_threshold_condition,
        ex:parent_beneficiary_tax_identification_and_return_condition,
        ex:parents_abroad_documentation_condition,
        ex:preceding_academic_year_course_completion_condition,
        ex:rented_study_residence_and_city_property_condition,
        ex:taxisnet_credentials_condition,
        ex:valid_academic_identity_card_condition .

ex:FamilyHome a ns1:Residence ;
    ns1:locatedIn ex:Thessaloniki ;
    ns1:residenceType "Owned" .

ex:academic_identity_card_validity a cccev:InformationConcept ;
    ex:mapsTo ex:KaterinaEduRecord .

ex:application_submission_deadline_condition a cccev:Constraint ;
    dct:description "Applications must be submitted within the prescribed period, normally from 1 to 30 June each year, unless a different deadline is set by a Ministry of Education circular." .

ex:cohabitation_tax_identification_condition a cccev:Constraint ;
    dct:description "For cohabitation, the tax identification number declared as tenant on behalf of the other student must match that of the cohabiting student, or the cohabiting student must be included as a dependent child in that person’s tax return." .

ex:cohabiting_student_eligibility_condition a cccev:Constraint ;
    dct:description "For the enhanced allowance based on cohabitation, the cohabiting person must be another undergraduate student at a higher education institution who is studying for a first degree; has not exceeded the prescribed period of study; does not hold another higher-education degree; studies in the same city or regional unit as the applicant; and is included as a tenant in the same lease arrangement." .

ex:combined_eligible_property_area_limit_condition a cccev:Constraint ;
    cccev:constrains ex:parent_property_area,
        ex:parent_property_municipality_population,
        ex:student_property_area,
        ex:student_property_municipality_population ;
    dct:description "The student’s parents, or the student themself, must not own or hold usufruct rights over owner-occupied or rented dwellings exceeding a combined total of 200 square metres. Dwellings or apartments located in a municipality or community with fewer than 3,000 inhabitants are excluded from this calculation." .

ex:dependent_children a cccev:InformationConcept ;
    ex:mapsTo ex:Fonis,
        ex:Katerina .

ex:divorced_or_separated_parent_beneficiary_condition a cccev:Constraint ;
    dct:description "In the case of divorced or separated spouses, the beneficiary is the parent on whom the student is dependent." .

ex:eu_or_greek_nationality_condition a cccev:Constraint ;
    cccev:constrains ex:student_citizenship_country ;
    dct:description "The student must be a Greek national or a national of another European Union Member State." .

ex:exceptional_student_beneficiary_condition a cccev:Constraint ;
    cccev:constrains ex:student_birth_date,
        ex:student_dependency_status ;
    dct:description "The student may exceptionally be the beneficiary if they are orphaned by both parents; have parents who reside abroad; are over 25 years old; or are required to submit an income tax return and are not considered a dependent member under Article 11 of Law 4172/2013. In such cases, the student declares only their spouse’s tax identification number, if applicable." .

ex:family_income_threshold_condition a cccev:Constraint ;
    cccev:constrains ex:dependent_children,
        ex:income_record_year,
        ex:preceding_year_family_income ;
    dct:description "The annual family income for the preceding year must not exceed €30,000, increased by €3,000 for each dependent child beyond the first." .

ex:income_record_year a cccev:InformationConcept ;
    ex:mapsTo ex:DadIncome,
        ex:KaterinaIncome,
        ex:MomIncome .

ex:lease_start_date a cccev:InformationConcept ;
    ex:mapsTo ex:StudentApartment .

ex:parent_beneficiary_tax_identification_and_return_condition a cccev:Constraint ;
    dct:description "Where a parent is the beneficiary, the application must state the student’s tax identification number (AFM) and that of the parent on whom the student is dependent. The parent must have submitted an income tax return for the year in which the housing-allowance application is filed." .

ex:parent_owned_property_city a cccev:InformationConcept ;
    ex:mapsTo ex:Thessaloniki,
        ex:TinyVillage .

ex:parent_property_area a cccev:InformationConcept ;
    ex:mapsTo ex:DadMainProperty,
        ex:MomVillageHouse .

ex:parent_property_municipality_population a cccev:InformationConcept ;
    ex:mapsTo ex:Thessaloniki,
        ex:TinyVillage .

ex:parents_abroad_documentation_condition a cccev:Constraint ;
    dct:description "Where the student’s parents reside abroad, the student must submit to the competent institution all documentation concerning both the student’s and the parents’—or the supporting parent’s—income and property situation in Greece and abroad. Foreign documents must be officially translated at the beneficiary’s responsibility." .

ex:passed_courses_count a cccev:InformationConcept ;
    ex:mapsTo ex:KaterinaEduRecord .

ex:preceding_academic_year_course_completion_condition a cccev:Constraint ;
    cccev:constrains ex:passed_courses_count,
        ex:total_courses_count ;
    dct:description "The student must have successfully passed examinations in at least half of the courses of the preceding academic year for which the allowance is requested." .

ex:preceding_year_family_income a cccev:InformationConcept ;
    ex:mapsTo ex:DadIncome,
        ex:KaterinaIncome,
        ex:MomIncome .

ex:primary_family_residence_city a cccev:InformationConcept ;
    ex:mapsTo ex:Thessaloniki .

ex:rented_study_residence_and_city_property_condition a cccev:Constraint ;
    cccev:constrains ex:lease_start_date,
        ex:parent_owned_property_city,
        ex:primary_family_residence_city,
        ex:student_owned_property_city,
        ex:student_rented_residence_city,
        ex:student_residence_type ;
    dct:description "The student must reside, because of their studies, in rented accommodation in a city other than their primary residence. Neither the student nor their parents may hold full ownership or usufruct rights over a dwelling in that city. The lease must be valid for at least six months." .

ex:student_birth_date a cccev:InformationConcept ;
    ex:mapsTo ex:Katerina .

ex:student_citizenship_country a cccev:InformationConcept ;
    ex:mapsTo ex:Katerina .

ex:student_dependency_status a cccev:InformationConcept ;
    ex:mapsTo ex:Katerina .

ex:student_owned_property_city a cccev:InformationConcept .

ex:student_property_area a cccev:InformationConcept .

ex:student_property_municipality_population a cccev:InformationConcept .

ex:student_rented_residence_city a cccev:InformationConcept ;
    ex:mapsTo ex:Athens .

ex:student_residence_type a cccev:InformationConcept ;
    ex:mapsTo ex:StudentApartment .

ex:taxisnet_credentials_condition a cccev:Constraint ;
    dct:description "The applicant must hold TAXISnet access credentials." .

ex:total_courses_count a cccev:InformationConcept ;
    ex:mapsTo ex:KaterinaEduRecord .

ex:valid_academic_identity_card_condition a cccev:Constraint ;
    cccev:constrains ex:academic_identity_card_validity ;
    dct:description "The student must hold a valid academic identity card." .

ex:Dad a ns1:Person ;
    ns1:birthDate "1970-01-01"^^xsd:date ;
    ns1:hasChild ex:Fonis,
        ex:Katerina ;
    ns1:hasIncome ex:DadIncome ;
    ns1:ownsRealEstate ex:DadMainProperty .

ex:DadMainProperty a ns1:RealEstateProperty ;
    ns1:propertyAreaM2 150.0 ;
    ns1:propertyLocation ex:Thessaloniki .

ex:Mom a ns1:Person ;
    ns1:birthDate "1975-03-15"^^xsd:date ;
    ns1:hasChild ex:Fonis,
        ex:Katerina ;
    ns1:hasIncome ex:MomIncome ;
    ns1:ownsRealEstate ex:MomVillageHouse .

ex:MomVillageHouse a ns1:RealEstateProperty ;
    ns1:propertyAreaM2 80.0 ;
    ns1:propertyLocation ex:TinyVillage .

ex:Athens a ns1:Municipality ;
    ns1:municipalityPopulation 664046 .

ex:DadIncome a ns1:IncomeRecord ;
    ns1:amount 25000.0 ;
    ns1:incomeYear "2024"^^xsd:gYear .

ex:Fonis a ns1:Person ;
    ns1:birthDate "2015-06-01"^^xsd:date ;
    ns1:hasParent ex:Dad,
        ex:Mom ;
    ns1:isDependent true .

ex:KaterinaIncome a ns1:IncomeRecord ;
    ns1:amount 0.0 ;
    ns1:incomeYear "2024"^^xsd:gYear .

ex:MomIncome a ns1:IncomeRecord ;
    ns1:amount 7000.0 ;
    ns1:incomeYear "2024"^^xsd:gYear .

ex:StudentApartment a ns1:Residence ;
    ns1:leaseStartDate "2024-09-01"^^xsd:date ;
    ns1:locatedIn ex:Athens ;
    ns1:residenceType "Rented" .

ex:TinyVillage a ns1:Municipality ;
    ns1:municipalityPopulation 500 .

ex:KaterinaEduRecord a ns1:EducationRecord ;
    ns1:cityOfStudy ex:Athens ;
    ns1:hasValidAcademicID true ;
    ns1:passedCoursesCount 6 ;
    ns1:totalCoursesCount 10 .

ex:Thessaloniki a ns1:Municipality ;
    ns1:municipalityPopulation 315196 .

ex:Katerina a ns1:Applicant,
        ns1:Person ;
    ns1:birthDate "2003-05-20"^^xsd:date ;
    ns1:citizenshipCountry "GR" ;
    ns1:hasCurrentResidence ex:StudentApartment ;
    ns1:hasEducation ex:KaterinaEduRecord ;
    ns1:hasFamilyResidence ex:FamilyHome ;
    ns1:hasIncome ex:KaterinaIncome ;
    ns1:hasParent ex:Dad,
        ex:Mom ;
    ns1:isDependent true .

