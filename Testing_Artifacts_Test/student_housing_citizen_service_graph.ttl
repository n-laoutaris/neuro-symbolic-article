@prefix cccev: <http://data.europa.eu/m8g/> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/> .
@prefix ns1: <http://example.org/schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:student_housing a cpsv:PublicService ;
    cpsv:holdsRequirement ex:cohabitation_enhanced_allowance_condition,
        ex:eligible_nationality_condition,
        ex:exceptional_student_beneficiary_condition,
        ex:family_income_threshold_condition,
        ex:minimum_lease_duration_condition,
        ex:minimum_passed_courses_condition,
        ex:no_student_or_parent_residence_in_rental_city_condition,
        ex:parent_beneficiary_requirements_condition,
        ex:rented_accommodation_outside_principal_residence_condition,
        ex:total_qualifying_residential_property_area_condition,
        ex:valid_academic_identity_card_condition .

ex:FamilyHome a ns1:Residence ;
    ns1:locatedIn ex:Thessaloniki ;
    ns1:residenceType "Owned" .

ex:academic_identity_card_validity a cccev:InformationConcept ;
    ex:mapsTo ex:KaterinaEduRecord .

ex:annual_family_income a cccev:InformationConcept ;
    ex:mapsTo ex:DadIncome,
        ex:KaterinaIncome,
        ex:MomIncome .

ex:cohabitation_enhanced_allowance_condition a cccev:Constraint ;
    dct:description "To qualify for the enhanced allowance due to cohabitation, the cohabiting person must be another undergraduate student at a higher education institution pursuing their first degree; not have exceeded the prescribed period of study; not already hold another higher-education degree; study in the same city or regional unit as the student; be named as the tenant, or be included as a dependent child in the tenant's tax return under the declared AFM; and be included as a tenant in the submitted lease." .

ex:current_accommodation_type a cccev:InformationConcept ;
    ex:mapsTo ex:StudentApartment .

ex:dependent_children a cccev:InformationConcept ;
    ex:mapsTo ex:Fonis,
        ex:Katerina .

ex:eligible_nationality_condition a cccev:Constraint ;
    cccev:constrains ex:student_citizenship_country ;
    dct:description "The student must be a Greek national or a national of another European Union Member State." .

ex:exceptional_student_beneficiary_condition a cccev:Constraint ;
    cccev:constrains ex:student_birth_date,
        ex:student_dependent_status ;
    dct:description "The student may exceptionally be the beneficiary if they are orphaned of both parents; have parents residing abroad; are over 25 years old; or are required to submit an income tax return and are not considered a dependent member under Article 11 of Law 4172/2013. In this case, only the spouse’s AFM, if applicable, is declared." .

ex:family_income_threshold_condition a cccev:Constraint ;
    cccev:constrains ex:annual_family_income,
        ex:dependent_children,
        ex:family_income_year ;
    dct:description "The annual family income for the preceding year must not exceed €30,000, increased by €3,000 for each dependent child beyond the first." .

ex:family_income_year a cccev:InformationConcept ;
    ex:mapsTo ex:DadIncome,
        ex:KaterinaIncome,
        ex:MomIncome .

ex:minimum_lease_duration_condition a cccev:Constraint ;
    cccev:constrains ex:rented_accommodation_lease_start_date ;
    dct:description "The lease must be valid for at least six months." .

ex:minimum_passed_courses_condition a cccev:Constraint ;
    cccev:constrains ex:passed_courses_count,
        ex:total_courses_count ;
    dct:description "The student must have successfully passed examinations in at least half of the courses of the preceding academic year for which the allowance is requested." .

ex:no_student_or_parent_residence_in_rental_city_condition a cccev:Constraint ;
    cccev:constrains ex:rented_accommodation_city,
        ex:student_or_parent_property_location ;
    dct:description "Neither the student nor their parents may hold full ownership or usufruct rights over a residence in the city where the student rents accommodation." .

ex:parent_beneficiary_requirements_condition a cccev:Constraint ;
    dct:description "Where a parent is the beneficiary: the student’s and the supporting parent’s Tax Identification Numbers (AFM) must be declared; if the parents are divorced or legally separated, the beneficiary is the parent who supports the student; and the supporting parent must have submitted an income tax return for the year in which the housing-allowance application is made." .

ex:passed_courses_count a cccev:InformationConcept ;
    ex:mapsTo ex:KaterinaEduRecord .

ex:principal_residence_city a cccev:InformationConcept ;
    ex:mapsTo ex:Thessaloniki .

ex:rented_accommodation_lease_start_date a cccev:InformationConcept ;
    ex:mapsTo ex:StudentApartment .

ex:rented_accommodation_outside_principal_residence_condition a cccev:Constraint ;
    cccev:constrains ex:current_accommodation_type,
        ex:principal_residence_city,
        ex:rented_accommodation_city,
        ex:study_city ;
    dct:description "The student must live, for study purposes, in rented accommodation in a city other than that of their principal residence." .

ex:student_birth_date a cccev:InformationConcept ;
    ex:mapsTo ex:Katerina .

ex:student_citizenship_country a cccev:InformationConcept ;
    ex:mapsTo ex:Katerina .

ex:student_dependent_status a cccev:InformationConcept ;
    ex:mapsTo ex:Katerina .

ex:student_or_parent_property_area a cccev:InformationConcept ;
    ex:mapsTo ex:DadMainProperty,
        ex:MomVillageHouse .

ex:student_or_parent_property_location a cccev:InformationConcept ;
    ex:mapsTo ex:Thessaloniki,
        ex:TinyVillage .

ex:student_or_parent_property_municipality_population a cccev:InformationConcept ;
    ex:mapsTo ex:Thessaloniki,
        ex:TinyVillage .

ex:study_city a cccev:InformationConcept ;
    ex:mapsTo ex:Athens .

ex:total_courses_count a cccev:InformationConcept ;
    ex:mapsTo ex:KaterinaEduRecord .

ex:total_qualifying_residential_property_area_condition a cccev:Constraint ;
    cccev:constrains ex:student_or_parent_property_area,
        ex:student_or_parent_property_municipality_population ;
    dct:description "The student’s parents, or the student themself, must not own or hold usufruct rights over residences—whether owner-occupied or rented out—exceeding a total of 200 sq. m. Residences or apartments located in a municipality or community with fewer than 3,000 inhabitants are excluded from this calculation." .

ex:valid_academic_identity_card_condition a cccev:Constraint ;
    cccev:constrains ex:academic_identity_card_validity ;
    dct:description "The student must hold a valid academic identity card." .

ex:Dad a ns1:Person ;
    ns1:birthDate "1970-01-01"^^xsd:date ;
    ns1:hasChild ex:Fonis,
        ex:Katerina ;
    ns1:hasIncome ex:DadIncome ;
    ns1:ownsRealEstate ex:DadMainProperty .

ex:DadMainProperty a ns1:RealEstateProperty ;
    ns1:propertyAreaM2 150.0 ;
    ns1:propertyLocation ex:Thessaloniki .

ex:Mom a ns1:Person ;
    ns1:birthDate "1975-03-15"^^xsd:date ;
    ns1:hasChild ex:Fonis,
        ex:Katerina ;
    ns1:hasIncome ex:MomIncome ;
    ns1:ownsRealEstate ex:MomVillageHouse .

ex:MomVillageHouse a ns1:RealEstateProperty ;
    ns1:propertyAreaM2 80.0 ;
    ns1:propertyLocation ex:TinyVillage .

ex:rented_accommodation_city a cccev:InformationConcept ;
    ex:mapsTo ex:Athens .

ex:DadIncome a ns1:IncomeRecord ;
    ns1:amount 25000.0 ;
    ns1:incomeYear "2024"^^xsd:gYear .

ex:Fonis a ns1:Person ;
    ns1:birthDate "2015-06-01"^^xsd:date ;
    ns1:hasParent ex:Dad,
        ex:Mom ;
    ns1:isDependent true .

ex:KaterinaIncome a ns1:IncomeRecord ;
    ns1:amount 0.0 ;
    ns1:incomeYear "2024"^^xsd:gYear .

ex:MomIncome a ns1:IncomeRecord ;
    ns1:amount 7000.0 ;
    ns1:incomeYear "2024"^^xsd:gYear .

ex:StudentApartment a ns1:Residence ;
    ns1:leaseStartDate "2024-09-01"^^xsd:date ;
    ns1:locatedIn ex:Athens ;
    ns1:residenceType "Rented" .

ex:TinyVillage a ns1:Municipality ;
    ns1:municipalityPopulation 500 .

ex:Athens a ns1:Municipality ;
    ns1:municipalityPopulation 664046 .

ex:KaterinaEduRecord a ns1:EducationRecord ;
    ns1:cityOfStudy ex:Athens ;
    ns1:hasValidAcademicID true ;
    ns1:passedCoursesCount 6 ;
    ns1:totalCoursesCount 10 .

ex:Thessaloniki a ns1:Municipality ;
    ns1:municipalityPopulation 315196 .

ex:Katerina a ns1:Applicant,
        ns1:Person ;
    ns1:birthDate "2003-05-20"^^xsd:date ;
    ns1:citizenshipCountry "GR" ;
    ns1:hasCurrentResidence ex:StudentApartment ;
    ns1:hasEducation ex:KaterinaEduRecord ;
    ns1:hasFamilyResidence ex:FamilyHome ;
    ns1:hasIncome ex:KaterinaIncome ;
    ns1:hasParent ex:Dad,
        ex:Mom ;
    ns1:isDependent true .

