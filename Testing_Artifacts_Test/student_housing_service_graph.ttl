@prefix ex: <http://example.org/> .
    @prefix cccev: <http://data.europa.eu/m8g/> .
    @prefix cpsv: <http://purl.org/vocab/cpsv#> .
    @prefix dct: <http://purl.org/dc/terms/> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

    ex:student_housing a cpsv:PublicService .

ex:student_housing cpsv:holdsRequirement ex:eligible_nationality_condition .
ex:eligible_nationality_condition a cccev:Constraint ; dct:description "The student must be a Greek national or a national of another European Union Member State." .
ex:eligible_nationality_condition cccev:constrains ex:student_citizenship_country .
ex:student_citizenship_country a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:valid_academic_identity_card_condition .
ex:valid_academic_identity_card_condition a cccev:Constraint ; dct:description "The student must hold a valid academic identity card." .
ex:valid_academic_identity_card_condition cccev:constrains ex:academic_identity_card_validity .
ex:academic_identity_card_validity a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:rented_accommodation_outside_principal_residence_condition .
ex:rented_accommodation_outside_principal_residence_condition a cccev:Constraint ; dct:description "The student must live, for study purposes, in rented accommodation in a city other than that of their principal residence." .
ex:rented_accommodation_outside_principal_residence_condition cccev:constrains ex:current_accommodation_type .
ex:current_accommodation_type a cccev:InformationConcept .
ex:rented_accommodation_outside_principal_residence_condition cccev:constrains ex:rented_accommodation_city .
ex:rented_accommodation_city a cccev:InformationConcept .
ex:rented_accommodation_outside_principal_residence_condition cccev:constrains ex:principal_residence_city .
ex:principal_residence_city a cccev:InformationConcept .
ex:rented_accommodation_outside_principal_residence_condition cccev:constrains ex:study_city .
ex:study_city a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:minimum_lease_duration_condition .
ex:minimum_lease_duration_condition a cccev:Constraint ; dct:description "The lease must be valid for at least six months." .
ex:minimum_lease_duration_condition cccev:constrains ex:rented_accommodation_lease_start_date .
ex:rented_accommodation_lease_start_date a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:no_student_or_parent_residence_in_rental_city_condition .
ex:no_student_or_parent_residence_in_rental_city_condition a cccev:Constraint ; dct:description "Neither the student nor their parents may hold full ownership or usufruct rights over a residence in the city where the student rents accommodation." .
ex:no_student_or_parent_residence_in_rental_city_condition cccev:constrains ex:student_or_parent_property_location .
ex:student_or_parent_property_location a cccev:InformationConcept .
ex:no_student_or_parent_residence_in_rental_city_condition cccev:constrains ex:rented_accommodation_city .
ex:rented_accommodation_city a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:family_income_threshold_condition .
ex:family_income_threshold_condition a cccev:Constraint ; dct:description "The annual family income for the preceding year must not exceed €30,000, increased by €3,000 for each dependent child beyond the first." .
ex:family_income_threshold_condition cccev:constrains ex:annual_family_income .
ex:annual_family_income a cccev:InformationConcept .
ex:family_income_threshold_condition cccev:constrains ex:family_income_year .
ex:family_income_year a cccev:InformationConcept .
ex:family_income_threshold_condition cccev:constrains ex:dependent_children .
ex:dependent_children a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:total_qualifying_residential_property_area_condition .
ex:total_qualifying_residential_property_area_condition a cccev:Constraint ; dct:description "The student’s parents, or the student themself, must not own or hold usufruct rights over residences—whether owner-occupied or rented out—exceeding a total of 200 sq. m. Residences or apartments located in a municipality or community with fewer than 3,000 inhabitants are excluded from this calculation." .
ex:total_qualifying_residential_property_area_condition cccev:constrains ex:student_or_parent_property_area .
ex:student_or_parent_property_area a cccev:InformationConcept .
ex:total_qualifying_residential_property_area_condition cccev:constrains ex:student_or_parent_property_municipality_population .
ex:student_or_parent_property_municipality_population a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:minimum_passed_courses_condition .
ex:minimum_passed_courses_condition a cccev:Constraint ; dct:description "The student must have successfully passed examinations in at least half of the courses of the preceding academic year for which the allowance is requested." .
ex:minimum_passed_courses_condition cccev:constrains ex:passed_courses_count .
ex:passed_courses_count a cccev:InformationConcept .
ex:minimum_passed_courses_condition cccev:constrains ex:total_courses_count .
ex:total_courses_count a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:parent_beneficiary_requirements_condition .
ex:parent_beneficiary_requirements_condition a cccev:Constraint ; dct:description "Where a parent is the beneficiary: the student’s and the supporting parent’s Tax Identification Numbers (AFM) must be declared; if the parents are divorced or legally separated, the beneficiary is the parent who supports the student; and the supporting parent must have submitted an income tax return for the year in which the housing-allowance application is made." .

ex:student_housing cpsv:holdsRequirement ex:exceptional_student_beneficiary_condition .
ex:exceptional_student_beneficiary_condition a cccev:Constraint ; dct:description "The student may exceptionally be the beneficiary if they are orphaned of both parents; have parents residing abroad; are over 25 years old; or are required to submit an income tax return and are not considered a dependent member under Article 11 of Law 4172/2013. In this case, only the spouse’s AFM, if applicable, is declared." .
ex:exceptional_student_beneficiary_condition cccev:constrains ex:student_birth_date .
ex:student_birth_date a cccev:InformationConcept .
ex:exceptional_student_beneficiary_condition cccev:constrains ex:student_dependent_status .
ex:student_dependent_status a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:cohabitation_enhanced_allowance_condition .
ex:cohabitation_enhanced_allowance_condition a cccev:Constraint ; dct:description "To qualify for the enhanced allowance due to cohabitation, the cohabiting person must be another undergraduate student at a higher education institution pursuing their first degree; not have exceeded the prescribed period of study; not already hold another higher-education degree; study in the same city or regional unit as the student; be named as the tenant, or be included as a dependent child in the tenant's tax return under the declared AFM; and be included as a tenant in the submitted lease." .

