@prefix ex: <http://example.org/> .
    @prefix cccev: <http://data.europa.eu/m8g/> .
    @prefix cpsv: <http://purl.org/vocab/cpsv#> .
    @prefix dct: <http://purl.org/dc/terms/> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

    ex:student_housing a cpsv:PublicService .

ex:student_housing cpsv:holdsRequirement ex:taxisnet_credentials_condition .
ex:taxisnet_credentials_condition a cccev:Constraint ; dct:description "The applicant must hold TAXISnet access credentials." .

ex:student_housing cpsv:holdsRequirement ex:eu_or_greek_nationality_condition .
ex:eu_or_greek_nationality_condition a cccev:Constraint ; dct:description "The student must be a Greek national or a national of another European Union Member State." .
ex:eu_or_greek_nationality_condition cccev:constrains ex:student_citizenship_country .
ex:student_citizenship_country a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:valid_academic_identity_card_condition .
ex:valid_academic_identity_card_condition a cccev:Constraint ; dct:description "The student must hold a valid academic identity card." .
ex:valid_academic_identity_card_condition cccev:constrains ex:academic_identity_card_validity .
ex:academic_identity_card_validity a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:family_income_threshold_condition .
ex:family_income_threshold_condition a cccev:Constraint ; dct:description "The annual family income for the preceding year must not exceed €30,000, increased by €3,000 for each dependent child beyond the first." .
ex:family_income_threshold_condition cccev:constrains ex:preceding_year_family_income .
ex:preceding_year_family_income a cccev:InformationConcept .
ex:family_income_threshold_condition cccev:constrains ex:income_record_year .
ex:income_record_year a cccev:InformationConcept .
ex:family_income_threshold_condition cccev:constrains ex:dependent_children .
ex:dependent_children a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:rented_study_residence_and_city_property_condition .
ex:rented_study_residence_and_city_property_condition a cccev:Constraint ; dct:description "The student must reside, because of their studies, in rented accommodation in a city other than their primary residence. Neither the student nor their parents may hold full ownership or usufruct rights over a dwelling in that city. The lease must be valid for at least six months." .
ex:rented_study_residence_and_city_property_condition cccev:constrains ex:student_residence_type .
ex:student_residence_type a cccev:InformationConcept .
ex:rented_study_residence_and_city_property_condition cccev:constrains ex:student_rented_residence_city .
ex:student_rented_residence_city a cccev:InformationConcept .
ex:rented_study_residence_and_city_property_condition cccev:constrains ex:primary_family_residence_city .
ex:primary_family_residence_city a cccev:InformationConcept .
ex:rented_study_residence_and_city_property_condition cccev:constrains ex:lease_start_date .
ex:lease_start_date a cccev:InformationConcept .
ex:rented_study_residence_and_city_property_condition cccev:constrains ex:student_owned_property_city .
ex:student_owned_property_city a cccev:InformationConcept .
ex:rented_study_residence_and_city_property_condition cccev:constrains ex:parent_owned_property_city .
ex:parent_owned_property_city a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:combined_eligible_property_area_limit_condition .
ex:combined_eligible_property_area_limit_condition a cccev:Constraint ; dct:description "The student’s parents, or the student themself, must not own or hold usufruct rights over owner-occupied or rented dwellings exceeding a combined total of 200 square metres. Dwellings or apartments located in a municipality or community with fewer than 3,000 inhabitants are excluded from this calculation." .
ex:combined_eligible_property_area_limit_condition cccev:constrains ex:student_property_area .
ex:student_property_area a cccev:InformationConcept .
ex:combined_eligible_property_area_limit_condition cccev:constrains ex:parent_property_area .
ex:parent_property_area a cccev:InformationConcept .
ex:combined_eligible_property_area_limit_condition cccev:constrains ex:student_property_municipality_population .
ex:student_property_municipality_population a cccev:InformationConcept .
ex:combined_eligible_property_area_limit_condition cccev:constrains ex:parent_property_municipality_population .
ex:parent_property_municipality_population a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:preceding_academic_year_course_completion_condition .
ex:preceding_academic_year_course_completion_condition a cccev:Constraint ; dct:description "The student must have successfully passed examinations in at least half of the courses of the preceding academic year for which the allowance is requested." .
ex:preceding_academic_year_course_completion_condition cccev:constrains ex:passed_courses_count .
ex:passed_courses_count a cccev:InformationConcept .
ex:preceding_academic_year_course_completion_condition cccev:constrains ex:total_courses_count .
ex:total_courses_count a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:parent_beneficiary_tax_identification_and_return_condition .
ex:parent_beneficiary_tax_identification_and_return_condition a cccev:Constraint ; dct:description "Where a parent is the beneficiary, the application must state the student’s tax identification number (AFM) and that of the parent on whom the student is dependent. The parent must have submitted an income tax return for the year in which the housing-allowance application is filed." .

ex:student_housing cpsv:holdsRequirement ex:divorced_or_separated_parent_beneficiary_condition .
ex:divorced_or_separated_parent_beneficiary_condition a cccev:Constraint ; dct:description "In the case of divorced or separated spouses, the beneficiary is the parent on whom the student is dependent." .

ex:student_housing cpsv:holdsRequirement ex:exceptional_student_beneficiary_condition .
ex:exceptional_student_beneficiary_condition a cccev:Constraint ; dct:description "The student may exceptionally be the beneficiary if they are orphaned by both parents; have parents who reside abroad; are over 25 years old; or are required to submit an income tax return and are not considered a dependent member under Article 11 of Law 4172/2013. In such cases, the student declares only their spouse’s tax identification number, if applicable." .
ex:exceptional_student_beneficiary_condition cccev:constrains ex:student_birth_date .
ex:student_birth_date a cccev:InformationConcept .
ex:exceptional_student_beneficiary_condition cccev:constrains ex:student_dependency_status .
ex:student_dependency_status a cccev:InformationConcept .

ex:student_housing cpsv:holdsRequirement ex:parents_abroad_documentation_condition .
ex:parents_abroad_documentation_condition a cccev:Constraint ; dct:description "Where the student’s parents reside abroad, the student must submit to the competent institution all documentation concerning both the student’s and the parents’—or the supporting parent’s—income and property situation in Greece and abroad. Foreign documents must be officially translated at the beneficiary’s responsibility." .

ex:student_housing cpsv:holdsRequirement ex:cohabiting_student_eligibility_condition .
ex:cohabiting_student_eligibility_condition a cccev:Constraint ; dct:description "For the enhanced allowance based on cohabitation, the cohabiting person must be another undergraduate student at a higher education institution who is studying for a first degree; has not exceeded the prescribed period of study; does not hold another higher-education degree; studies in the same city or regional unit as the applicant; and is included as a tenant in the same lease arrangement." .

ex:student_housing cpsv:holdsRequirement ex:cohabitation_tax_identification_condition .
ex:cohabitation_tax_identification_condition a cccev:Constraint ; dct:description "For cohabitation, the tax identification number declared as tenant on behalf of the other student must match that of the cohabiting student, or the cohabiting student must be included as a dependent child in that person’s tax return." .

ex:student_housing cpsv:holdsRequirement ex:application_submission_deadline_condition .
ex:application_submission_deadline_condition a cccev:Constraint ; dct:description "Applications must be submitted within the prescribed period, normally from 1 to 30 June each year, unless a different deadline is set by a Ministry of Education circular." .

